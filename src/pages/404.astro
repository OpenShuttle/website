---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { routes } from '../i18n/routes';
---

<Base locale="fr" page="404" title="Page introuvable · OpenShuttle" description="Cette page n’existe pas ou a été déplacée." noindex>
  <PageHeader title="Page introuvable" lead="Cette page n’existe pas ou a été déplacée.">
    <p lang="en" class="muted">This page does not exist or has moved.</p>
    <div class="btn-row">
      <a class="btn btn-primary" href={routes.home.fr}>Retour à l’accueil</a>
      <a class="btn btn-secondary" href={routes.home.en} lang="en">English home page</a>
    </div>
  </PageHeader>
</Base>
