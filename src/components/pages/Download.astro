      text: 'Mac avec puce Apple (M1 et suivantes). Décompressez puis glissez l’app dans Applications.',
      btn: 'Télécharger pour macOS (.zip)',
    },
    linux: {
      deb: 'Paquet Debian / Ubuntu',
      debText: 'Debian 13 et suivantes, Ubuntu 24.04 et suivantes.',
      debBtn: 'Télécharger le .deb',
      tar: 'Binaire Linux',
      tarText: 'Pour les autres distributions. Nécessite GTK 4 et WebKitGTK 6.',
      tarBtn: 'Télécharger le .tar.gz',
    },
    integrity: 'Vérifier l’intégrité :',
    checksums: 'sommes de contrôle SHA-256',
