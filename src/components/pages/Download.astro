    firstH2: 'Premier lancement',
    firstText:
      'Votre système peut afficher un avertissement la première fois : OpenShuttle est un logiciel libre récent, pas encore reconnu par Windows et macOS. C’est attendu, voici comment continuer.',
    firstWindows: [
      'Une fenêtre bleue « Windows a protégé votre ordinateur » apparaît.',
      'Cliquez sur <strong>Informations complémentaires</strong>.',
      'Cliquez sur <strong>Exécuter quand même</strong>.',
    ],
    firstMac: [
      'Ouvrez OpenShuttle une première fois, puis fermez le message.',
      'Allez dans <strong>Réglages système → Confidentialité et sécurité</strong>.',
      'En bas, cliquez sur <strong>Ouvrir quand même</strong>.',
    ],
    nextTitle: 'Et ensuite ?',
    nextText1: 'Suivez le',
    nextLink: 'guide',
    nextText2: ' : un tournoi complet en dix étapes, de l’inscription au classement final.',
    updatesTitle: 'Mises à jour',
    updatesText: 'Téléchargez la nouvelle version et installez-la par-dessus : vos tournois sont conservés.',
    problemTitle: 'Un problème ?',
    problemText1: 'Signalez-le sur',
    problemText2: ', avec votre système et ce que vous faisiez.',
  },
  en: {
    title: 'Download OpenShuttle for Windows, macOS and Linux',
    description:
      'Download OpenShuttle, the free badminton club tournament software: Windows installer, portable version, macOS (Apple silicon), Debian/Ubuntu package and Linux binary.',
    h1: 'Download OpenShuttle',
    lead: 'Free, no account, and no internet once installed. Latest release, published on GitHub:',
    releaseNotes: 'release notes',
    tabsLabel: 'Operating system',
    recommended: 'Recommended',
    windows: {
      installer: 'Windows installer',
      installerText: 'Windows 10 and 11, 64-bit. Also installs WebView2 if it is missing.',
      installerBtn: 'Download the installer (.exe)',
      portable: 'Portable version',
      portableText: 'No installation, run it from a USB stick. Needs WebView2, included in Windows 11.',
      portableBtn: 'Download the zip',
    },
    mac: {
      title: 'OpenShuttle for Mac',
      text: 'Mac with Apple silicon (M1 and later). Unzip, then drag the app to Applications.',
      btn: 'Download for macOS (.zip)',
    },
    linux: {
      deb: 'Debian / Ubuntu package',
      debText: 'Debian 13 and later, Ubuntu 24.04 and later.',
      debBtn: 'Download the .deb',
      tar: 'Linux binary',
      tarText: 'For other distributions. Needs GTK 4 and WebKitGTK 6.',
      tarBtn: 'Download the .tar.gz',
    },
    integrity: 'Check integrity:',
    checksums: 'SHA-256 checksums',
    source: 'Source code on',
    firstH2: 'First launch',
    firstText:
      'Your system may show a warning the first time: OpenShuttle is new open source software, not yet recognised by Windows and macOS. This is expected, here is how to carry on.',
    firstWindows: [
      'A blue “Windows protected your PC” window appears.',
      'Click <strong>More info</strong>.',
      'Click <strong>Run anyway</strong>.',
    ],
    firstMac: [
      'Open OpenShuttle once, then close the message.',
      'Go to <strong>System Settings → Privacy &amp; Security</strong>.',
      'At the bottom, click <strong>Open Anyway</strong>.',
    ],
    nextTitle: 'What next?',
    nextText1: 'Follow the',
    nextLink: 'guide',
    nextText2: ': a full tournament in ten steps, from entries to final standings.',
    updatesTitle: 'Updates',
    updatesText: 'Download the new version and install it over the old one: your tournaments are kept.',
    problemTitle: 'Something wrong?',
    problemText1: 'Report it on',
    problemText2: ', with your system and what you were doing.',
  },
}[locale];

const systems = [
  { id: 'windows', label: 'Windows' },
  { id: 'macos', label: 'macOS' },
  { id: 'linux', label: 'Linux' },
] as const;
---

<Base locale={locale} page="download" title={copy.title} description={copy.description}>
  <section class="band-soft top-band">
    <div class="container-narrow top stack">
      <div class="stack intro">
        <h1 class="h1 download-h1">{copy.h1}</h1>
        <p class="lead">{copy.lead} <a href={github.releases}>{copy.releaseNotes}</a>.</p>
      </div>

      <div class="tabs" role="tablist" aria-label={copy.tabsLabel} hidden>
        {
          systems.map((os, i) => (
            <button
              type="button"
              role="tab"
              id={`tab-${os.id}`}
              aria-controls={`panel-${os.id}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
              data-os={os.id}
            >
              {os.label}
            </button>
          ))
        }
      </div>

      <div class="panels">
        <section class="panel" id="panel-windows" role="tabpanel" aria-labelledby="os-windows">
          <h2 class="os-heading" id="os-windows">Windows</h2>
          <div class="grid-auto">
            <div class="card dl-card dl-main">
              <span class="badge-ok">{copy.recommended}</span>
              <h3>{copy.windows.installer}</h3>
              <p class="body">{copy.windows.installerText}</p>
              <a class="btn btn-primary" href={dl('windows')}>
                <Icon name="download" size={20} strokeWidth={2.2} />
                {copy.windows.installerBtn}
              </a>
            </div>
            <div class="card dl-card">
              <h3>{copy.windows.portable}</h3>
              <p class="body">{copy.windows.portableText}</p>
              <a class="btn btn-secondary" href={dl('windows-portable')}>{copy.windows.portableBtn}</a>
            </div>
          </div>
        </section>

        <section class="panel" id="panel-macos" role="tabpanel" aria-labelledby="os-macos">
          <h2 class="os-heading" id="os-macos">macOS</h2>
          <div class="card dl-card dl-main dl-single">
            <h3>{copy.mac.title}</h3>
            <p class="body">{copy.mac.text}</p>
            <a class="btn btn-primary" href={dl('macos')}>
              <Icon name="download" size={20} strokeWidth={2.2} />
              {copy.mac.btn}
            </a>
          </div>
        </section>

        <section class="panel" id="panel-linux" role="tabpanel" aria-labelledby="os-linux">
          <h2 class="os-heading" id="os-linux">Linux</h2>
          <div class="grid-auto">
            <div class="card dl-card dl-main">
              <h3>{copy.linux.deb}</h3>
              <p class="body">{copy.linux.debText}</p>
              <a class="btn btn-primary" href={dl('linux-deb')}>{copy.linux.debBtn}</a>
            </div>
            <div class="card dl-card">
              <h3>{copy.linux.tar}</h3>
              <p class="body">{copy.linux.tarText}</p>
              <a class="btn btn-secondary" href={dl('linux-tar')}>{copy.linux.tarBtn}</a>
            </div>
          </div>
        </section>
      </div>

      <p class="small muted">
        {copy.integrity} <a href={dl('checksums')}>{copy.checksums}</a> · {copy.source} <a href={github.repo}>GitHub</a>
      </p>
    </div>
  </section>

  <section class="container-narrow first stack" aria-labelledby="first-title">
    <div class="stack first-head">
      <h2 id="first-title" class="h2-sm">{copy.firstH2}</h2>
      <p class="body-lg">{copy.firstText}</p>
    </div>
    <div class="grid-auto">
      <div class="card-soft first-card">
        <h3>Windows</h3>
        <ol class="list">{copy.firstWindows.map((step) => <li set:html={step} />)}</ol>
      </div>
      <div class="card-soft first-card">
        <h3>macOS</h3>
        <ol class="list">{copy.firstMac.map((step) => <li set:html={step} />)}</ol>
      </div>
    </div>
  </section>

  <section class="band-soft after-band">
    <div class="container-narrow grid-auto after" style="--min: 260px">
      <div class="stack after-item">
        <h2>{copy.nextTitle}</h2>
        <p class="body">{copy.nextText1} <a href={routes.guide[locale]}>{copy.nextLink}</a>{copy.nextText2}</p>
      </div>
      <div class="stack after-item">
        <h2>{copy.updatesTitle}</h2>
        <p class="body">{copy.updatesText}</p>
      </div>
      <div class="stack after-item">
        <h2>{copy.problemTitle}</h2>
        <p class="body">{copy.problemText1} <a href={github.issues}>GitHub</a>{copy.problemText2}</p>
      </div>
    </div>
  </section>
</Base>

<script is:inline>
  // Progressive enhancement: without JavaScript every system stays listed.
  // With it, the panels become tabs and the visitor's system is preselected.
  (() => {
    const tablist = document.querySelector('[role="tablist"]');
    if (!tablist) return;
    const tabs = Array.from(tablist.querySelectorAll('[role="tab"]'));
    const ids = tabs.map((t) => t.dataset.os);
    const select = (id, focus) => {
      tabs.forEach((tab) => {
        const on = tab.dataset.os === id;
        tab.setAttribute('aria-selected', String(on));
        tab.tabIndex = on ? 0 : -1;
        document.getElementById('panel-' + tab.dataset.os).hidden = !on;
        if (on && focus) tab.focus();
      });
    };
    const detect = () => {
      const hash = location.hash.slice(1);
      if (ids.includes(hash)) return hash;
      const p = ((navigator.userAgentData && navigator.userAgentData.platform) || navigator.userAgent).toLowerCase();
      if (/mac/.test(p) && !/iphone|ipad/.test(navigator.userAgent.toLowerCase())) return 'macos';
      if (/linux|x11/.test(p) && !/android/.test(navigator.userAgent.toLowerCase())) return 'linux';
      return 'windows';
    };
    document.documentElement.classList.add('os-tabs');
    tablist.hidden = false;
    select(detect(), false);
    tablist.addEventListener('click', (e) => {
      const tab = e.target.closest('[role="tab"]');
      if (tab) select(tab.dataset.os, false);
    });
    tablist.addEventListener('keydown', (e) => {
      const i = tabs.indexOf(document.activeElement);
      if (i < 0) return;
      const moves = { ArrowRight: i + 1, ArrowLeft: i - 1, Home: 0, End: tabs.length - 1 };
      if (!(e.key in moves)) return;
      e.preventDefault();
      select(ids[(moves[e.key] + tabs.length) % tabs.length], true);
    });
  })();
</script>

<style>
  .top-band {
    border-bottom: 1px solid var(--color-border);
  }

  .top {
    padding-top: 64px;
    padding-bottom: 72px;
    gap: 28px;
  }

  .intro {
    gap: 12px;
  }

  .download-h1 {
    font-size: clamp(2.25rem, 1.6rem + 2.4vw, 3rem);
  }

  .tabs {
    align-self: flex-start;
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    padding: 4px;
    border-radius: 10px;
    background: var(--color-border);
  }

  .tabs[hidden] {
    display: none;
  }

  .tabs button {
    min-height: 44px;
    padding: 0 20px;
    border: 0;
    border-radius: 8px;
    font: inherit;
    font-size: 16px;
    font-weight: 700;
    cursor: pointer;
    background: transparent;
    color: var(--color-text-body);
  }

  .tabs button[aria-selected='true'] {
    background: #ffffff;
    color: var(--color-text);
    box-shadow: 0 1px 3px rgb(22 24 29 / 0.15);
  }

  .panels {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .os-heading {
    font-size: 22px;
    margin-bottom: 12px;
  }

  :global(.os-tabs) .os-heading {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  .grid-auto {
    gap: 16px;
  }

  .dl-card {
    gap: 12px;
  }

  .dl-card h3 {
    font-size: 24px;
  }

  .dl-card .btn {
    margin-top: auto;
  }

  .dl-card .body {
    margin-bottom: 8px;
  }

  .dl-main {
    border: 2px solid var(--color-primary);
  }

  .dl-single {
    max-width: 520px;
  }

  .badge-ok {
    align-self: flex-start;
    padding: 3px 10px;
    border-radius: 999px;
    background: var(--color-success-bg);
    color: var(--color-success);
    font-size: 13px;
    font-weight: 800;
  }

  .first {
    padding-top: 72px;
    padding-bottom: 72px;
    gap: 24px;
  }

  .first-head {
    gap: 10px;
  }

  .first-card {
    gap: 12px;
  }

  .first-card h3 {
    font-size: 20px;
  }

  .after-band {
    border-top: 1px solid var(--color-border);
  }

  .after {
    padding-top: 64px;
    padding-bottom: 64px;
    gap: 28px;
  }

  .after-item {
    gap: 8px;
  }

  .after-item h2 {
    font-size: 19px;
  }

  @media (max-width: 640px) {
    .top {
      padding-top: 48px;
      padding-bottom: 56px;
    }

    .first,
    .after {
      padding-top: 56px;
      padding-bottom: 56px;
    }
  }
</style>
