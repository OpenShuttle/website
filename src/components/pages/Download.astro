    releaseNotes: 'notes de version',
    tabsLabel: 'Système',
    recommended: 'Recommandé',
    windows: {
      installer: 'Installateur Windows',
      installerText: 'Windows 10 et 11, 64 bits. Installe aussi WebView2 s’il manque.',
      installerBtn: 'Télécharger l’installateur (.exe)',
      portable: 'Version portable',
      portableText: 'Sans installation, à lancer depuis une clé USB. Nécessite WebView2, présent sur Windows 11.',
      portableBtn: 'Télécharger le zip',
    },
    mac: {
