---
import { home } from '../../data/home';
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Icon from '../Icon.astro';
import FaqList from '../FaqList.astro';
import { faq } from '../../data/faq';
import { author, github, routes, type Locale } from '../../i18n/routes';
import shotDesk from '../../assets/shot-desk.png';
import shotSchedule from '../../assets/shot-schedule.png';
import shotDisplay from '../../assets/shot-display.png';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const copy = home[locale];

const site = Astro.site!;
const softwareApplication = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'OpenShuttle',
  description: copy.appDescription,
  url: new URL(routes.home[locale], site).href,
  downloadUrl: new URL(routes.download[locale], site).href,
  applicationCategory: 'SportsApplication',
  operatingSystem: 'Windows 10, Windows 11, macOS, Linux',
  inLanguage: ['fr', 'en'],
  isAccessibleForFree: true,
  license: 'https://www.gnu.org/licenses/agpl-3.0.html',
  image: new URL(`/og/openshuttle-${locale}.png`, site).href,
  screenshot: new URL(shotDesk.src, site).href,
  codeRepository: github.repo,
  author: { '@type': 'Person', name: author.name, url: author.url },
  creator: { '@type': 'Person', name: author.name, url: author.url },
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
};

// Rendered width of the screenshots, from the flex layout below: full width
// (minus the 2 × 24 px gutters) until text and image sit side by side, then
// the image's share of the row, fixed once the container reaches 1200 px.
const heroSizes = '(min-width: 1200px) 644px, (min-width: 1056px) 54vw, calc(100vw - 48px)';
const splitSizes = '(min-width: 1200px) 672px, (min-width: 1016px) 56vw, calc(100vw - 48px)';

const homeFaq = faq[locale].filter((item) => item.home);
---

<Base locale={locale} page="home" title={copy.title} description={copy.description} jsonLd={[softwareApplication]}>
  <section class="band-soft hero-band">
    <div class="container hero">
      <div class="hero-text stack">
        <span class="pill">{copy.pill}</span>
        <h1 class="h1">{copy.h1}</h1>
        <p class="lead hero-lead">{copy.lead}</p>
        <div class="btn-row">
          <a class="btn btn-primary" href={routes.download[locale]}>
            <Icon name="download" size={20} strokeWidth={2.2} />
            {copy.ctaDownload}
          </a>
          <a class="btn btn-secondary" href={routes.guide[locale]}>{copy.ctaGuide}</a>
        </div>
        <span class="small muted">
          {copy.heroNote} <a href={routes.download[locale]}>{copy.heroNoteLink}</a>
        </span>
      </div>
      <div class="hero-media">
        <Picture
          src={shotDesk}
          alt={copy.deskAlt}
          class="shot"
          formats={['avif', 'webp']}
          widths={[480, 640, 800, 1280]}
          sizes={heroSizes}
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <section class="highlights-band" aria-label={copy.highlightsLabel}>
    <ul class="container grid-auto highlights" style="--min: 240px">
      {
        copy.highlights.map((h) => (
          <li class="highlight">
            <span class="highlight-icon">
              <Icon name={h.icon as 'offline'} size={28} />
            </span>
            <div>
              <strong class="highlight-title">{h.title}</strong>
              <span class="highlight-text">{h.text}</span>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section id={copy.featuresId} class="container features" aria-labelledby="features-title">
    <div class="section-head stack">
      <span class="eyebrow">{copy.featuresEyebrow}</span>
      <h2 id="features-title" class="h2">{copy.featuresH2}</h2>
      <p class="body-lg">{copy.featuresLead}</p>
    </div>
    <div class="grid-auto steps">
      {
        copy.steps.map((step) => (
          <div class="card step">
            <span class="step-label">{step.label}</span>
            <h3>{step.title}</h3>
            <ul class="list">
              {step.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <section class="container split" aria-labelledby="schedule-title">
    <div class="split-media">
      <Picture src={shotSchedule} alt={copy.scheduleAlt} class="shot shot-soft" sizes={splitSizes} formats={['avif', 'webp']} widths={[480, 640, 800, 1280]} loading="lazy" />
    </div>
    <div class="split-text stack">
      <span class="eyebrow">{copy.scheduleEyebrow}</span>
      <h2 id="schedule-title" class="h2-sm">{copy.scheduleH2}</h2>
      <p class="body-lg">{copy.scheduleText}</p>
      <ul class="checks">
        {
          copy.scheduleChecks.map((c) => (
            <li>
              <span aria-hidden="true">✓</span>
              {c}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="band-dark on-dark" aria-labelledby="display-title">
    <div class="container split split-dark">
      <div class="split-text stack">
        <span class="badge-accent">{copy.displayBadge}</span>
        <h2 id="display-title" class="h2-sm">{copy.displayH2}</h2>
        <p class="body-lg on-dark-text">{copy.displayText}</p>
      </div>
      <div class="split-media">
        <Picture src={shotDisplay} alt={copy.displayAlt} class="shot shot-dark" sizes={splitSizes} formats={['avif', 'webp']} widths={[480, 640, 800, 1440]} loading="lazy" />
      </div>
    </div>
  </section>

  <section class="container events" aria-labelledby="events-title">
    <div class="section-head stack">
      <span class="eyebrow">{copy.eventsEyebrow}</span>
      <h2 id="events-title" class="h2">{copy.eventsH2}</h2>
    </div>
    <div class="grid-auto events-grid" style="--min: 250px">
      {
        copy.events.map((e) => (
          <div class="card-soft">
            <h3>{e.title}</h3>
            <p class="body">{e.text}</p>
          </div>
        ))
      }
    </div>
  </section>

  <div class="container values">
    <div class="grid-auto" style="--min: 320px">
      <div class="card value">
        <span class="value-icon"><Icon name="lock" size={32} /></span>
        <h3>{copy.dataTitle}</h3>
        <p class="body">{copy.dataText}</p>
      </div>
      <div class="card value">
        <span class="value-icon"><Icon name="code" size={32} /></span>
        <h3>{copy.openTitle}</h3>
        <p class="body">{copy.openText} <a href={github.repo}>GitHub</a>{copy.openText2}</p>
      </div>
    </div>
  </div>

  <section id="faq" class="band-soft faq-band" aria-labelledby="faq-title">
    <div class="container-faq stack">
      <h2 id="faq-title" class="h2">{copy.faqH2}</h2>
      <FaqList items={homeFaq} />
      <a class="faq-more" href={routes.faq[locale]}>{copy.faqMore} →</a>
    </div>
  </section>

  <section class="band-primary" aria-labelledby="cta-title">
    <div class="container cta">
      <div class="cta-text stack">
        <h2 id="cta-title" class="h2">{copy.ctaH2}</h2>
        <p class="body-lg cta-lead">{copy.ctaText}</p>
      </div>
      <div class="btn-row">
        <a class="btn btn-accent" href={routes.download[locale]}>{copy.ctaDownloadShort}</a>
        <a class="btn btn-outline-light" href={routes.guide[locale]}>{copy.ctaReadGuide}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero-band {
    border-bottom: 1px solid var(--color-border);
  }

  .hero {
    padding-top: 72px;
    padding-bottom: 80px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 48px;
  }

  .hero-text {
    flex: 1 1 400px;
    min-width: 0;
    gap: 22px;
  }

  .hero-lead {
    max-width: 560px;
  }

  .hero-media {
    flex: 1 1 560px;
    min-width: 0;
  }

  .highlights-band {
    border-bottom: 1px solid var(--color-border);
  }

  .highlights {
    list-style: none;
    padding-top: 40px;
    padding-bottom: 40px;
    gap: 28px;
  }

  .highlight {
    display: flex;
    gap: 14px;
  }

  .highlight-icon,
  .value-icon {
    flex: none;
    color: var(--color-primary);
  }

  .highlight-title {
    display: block;
    font-weight: 800;
    font-size: 17px;
  }

  .highlight-text {
    display: block;
    color: var(--color-muted);
    font-size: 15px;
  }

  .section-head {
    max-width: 720px;
    gap: 14px;
  }

  .features {
    padding-top: 88px;
    padding-bottom: 40px;
  }

  .steps {
    margin-top: 44px;
  }

  .step {
    gap: 14px;
  }

  .step h3 {
    font-size: 24px;
  }

  .split {
    padding-top: 64px;
    padding-bottom: 64px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 48px;
  }

  .split-dark {
    padding-top: 88px;
    padding-bottom: 88px;
  }

  .split-media {
    flex: 1 1 560px;
    min-width: 0;
  }

  .split-text {
    flex: 1 1 360px;
    min-width: 0;
    gap: 16px;
  }

  .shot-soft {
    box-shadow: 0 18px 44px rgb(22 24 29 / 0.14);
  }

  .shot-dark {
    border-color: #3a3f4b;
    box-shadow: none;
  }

  .checks {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: 16px;
  }

  .checks li {
    display: flex;
    gap: 10px;
  }

  .checks span {
    color: var(--color-primary);
    font-weight: 800;
  }

  .badge-accent {
    align-self: flex-start;
    padding: 4px 12px;
    border-radius: 6px;
    background: var(--color-accent);
    color: var(--color-text);
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .on-dark-text {
    color: var(--color-on-dark);
  }

  .events {
    padding-top: 88px;
    padding-bottom: 40px;
  }

  .events-grid {
    margin-top: 40px;
  }

  .values {
    padding-top: 48px;
    padding-bottom: 88px;
  }

  .value {
    padding: 32px;
  }

  .faq-band {
    border-top: 1px solid var(--color-border);
  }

  .container-faq {
    max-width: 860px;
    margin: 0 auto;
    padding: 88px var(--gutter);
    gap: 28px;
  }

  .faq-more {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 17px;
    font-weight: 700;
  }

  .cta {
    padding-top: 80px;
    padding-bottom: 80px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
  }

  .cta-text {
    flex: 1 1 480px;
    gap: 12px;
  }

  .cta-lead {
    color: var(--color-primary-soft);
  }

  @media (max-width: 640px) {
    .hero {
      padding-top: 48px;
      padding-bottom: 56px;
      gap: 36px;
    }

    .features,
    .events {
      padding-top: 64px;
    }

    .split-dark,
    .container-faq,
    .cta {
      padding-top: 64px;
      padding-bottom: 64px;
    }

    .values {
      padding-bottom: 64px;
    }
  }
</style>
