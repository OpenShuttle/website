---
import { guidePage } from '../../data/pages';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHeader from '../PageHeader.astro';
import Lightbox from '../Lightbox.astro';
import ZoomableShot from '../ZoomableShot.astro';
import { routes, type Locale } from '../../i18n/routes';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const copy = guidePage[locale];

const entries = (await getCollection('guide', (entry) => entry.id.startsWith(`${locale}/`))).sort(
  (a, b) => a.data.step - b.data.step,
);
const steps = await Promise.all(
  entries.map(async (entry) => ({ ...entry.data, Content: (await render(entry)).Content })),
);
const pad = (n: number) => String(n).padStart(2, '0');
const groups = [
  { label: copy.before, steps: steps.filter((s) => s.step <= 3) },
  { label: copy.dayOf, steps: steps.filter((s) => s.step > 3) },
];
---

<Base locale={locale} page="guide" title={copy.title} description={copy.description}>
  <PageHeader eyebrow={copy.eyebrow} title={copy.h1} lead={copy.lead} />

  <div class="container guide-layout">
    <nav class="side-toc" aria-label={copy.tocLabel}>
      <span class="side-toc-title">{copy.tocLabel}</span>
      <ol>
        {
          steps.map((s) => (
            <li>
              <a href={`#${copy.anchor}-${s.step}`} data-step={s.step}>
                <span class="side-num">{pad(s.step)}</span>
                <span>{s.title}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>

  <div class="guide">
    <nav class="toc" id="toc" aria-labelledby="toc-title">
      <h2 id="toc-title" class="toc-title">{copy.tocLabel}</h2>
      {
        groups.map((group) => (
          <div class="toc-group">
            <span class="toc-group-label">{group.label}</span>
            <ol class="toc-list">
              {group.steps.map((s) => (
                <li value={s.step}>
                  <a href={`#${copy.anchor}-${s.step}`}>
                    <span class="step-label">{pad(s.step)}</span>
                    <span class="toc-text">
                      <span class="toc-step-title">{s.title}</span>
                      <span class="toc-summary">{s.summary}</span>
                    </span>
                  </a>
                </li>
              ))}
            </ol>
          </div>
        ))
      }
    </nav>

    {
      steps.map(({ step, title, images, Content }) => (
        <section class="step" id={`${copy.anchor}-${step}`} aria-labelledby={`${copy.anchor}-${step}-title`}>
          <span class="step-label">
            {copy.stepPrefix} {pad(step)} / 10
          </span>
          <h2 id={`${copy.anchor}-${step}-title`} class="step-title">
            {title}
          </h2>
          <div class="prose">
            <Content />
          </div>
          {images.length > 0 && (
            <ul class="shots" role="list">
              {images.map((img) => (
                <li>
                  <figure>
                    <ZoomableShot
                      locale={locale}
                      src={img.src}
                      alt={img.alt}
                      class="thumb"
                      widths={[320, 480, 640]}
                      sizes="(min-width: 640px) 240px, 72vw"
                    />
                    <figcaption>{img.caption}</figcaption>
                  </figure>
                </li>
              ))}
            </ul>
          )}
          <a class="back" href="#toc">
            ↑ {copy.backToTop}
          </a>
        </section>
      ))
    }

    <aside class="cta card">
      <h2>{copy.ctaTitle}</h2>
      <p class="body">{copy.ctaText}</p>
      <div class="btn-row">
        <a class="btn btn-primary" href={routes.download[locale]}>{copy.ctaButton}</a>
        <a class="btn btn-secondary" href={routes.faq[locale]}>{copy.faqLink}</a>
      </div>
    </aside>
  </div>
  </div>
  <Lightbox locale={locale} />
</Base>

<script is:inline>
  // Highlights the step being read in the side table of contents.
  (() => {
    const links = new Map(
      Array.from(document.querySelectorAll('.side-toc a')).map((a) => [a.getAttribute('href').slice(1), a]),
    );
    if (!links.size || !('IntersectionObserver' in window)) return;
    const visible = new Set();
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => (e.isIntersecting ? visible.add(e.target.id) : visible.delete(e.target.id)));
        const current = Array.from(links.keys()).find((id) => visible.has(id));
        if (!current) return;
        links.forEach((a, id) => (id === current ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current')));
      },
      { rootMargin: '-90px 0px -55% 0px' },
    );
    links.forEach((_, id) => {
      const section = document.getElementById(id);
      if (section) observer.observe(section);
    });
  })();
</script>

<style>
  .guide-layout {
    padding-top: 56px;
    padding-bottom: 88px;
  }

  .guide {
    max-width: 912px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 56px;
  }

  .side-toc {
    display: none;
  }

  /* Desktop: the table of contents moves to a sticky column on the left. */
  @media (min-width: 1100px) {
    .guide-layout {
      display: grid;
      grid-template-columns: 250px minmax(0, 780px);
      justify-content: center;
      gap: 64px;
      align-items: start;
    }

    .guide {
      margin: 0;
    }

    .side-toc {
      display: block;
      position: sticky;
      top: 96px;
    }

    .toc,
    .back {
      display: none;
    }
  }

  .side-toc-title {
    display: block;
    margin-bottom: 8px;
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .side-toc ol {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 2px solid var(--color-border);
  }

  .side-toc a {
    display: flex;
    gap: 10px;
    align-items: baseline;
    min-height: 36px;
    padding: 6px 12px;
    margin-left: -2px;
    border-left: 2px solid transparent;
    font-size: 15px;
    line-height: 1.3;
    color: var(--color-text-body);
    text-decoration: none;
  }

  .side-toc a:hover {
    color: var(--color-primary);
  }

  .side-toc a[aria-current='true'] {
    border-left-color: var(--color-primary);
    color: var(--color-text);
    font-weight: 700;
  }

  .side-num {
    font: 700 13px var(--font-mono);
    color: var(--color-muted);
  }

  /* Screenshots of a step: one row, scrolling sideways when they do not fit. */
  .shots {
    list-style: none;
    margin: 8px 0 0;
    padding: 4px 4px 12px;
    display: flex;
    gap: 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
  }

  .shots li {
    flex: 0 0 min(240px, 72vw);
    scroll-snap-align: start;
  }

  .shots figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .shots figcaption {
    font-size: 14px;
    color: var(--color-muted);
  }

  /* Same box for every thumbnail, whatever the screenshot's shape. */
  .shots :global(.thumb) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: contain;
    background: var(--color-bg-soft);
    border-radius: 8px;
    border: 1px solid var(--color-border-strong);
    box-shadow: 0 4px 14px rgb(22 24 29 / 0.1);
  }

  .shots :global(.zoom-hint) {
    right: 8px;
    bottom: 8px;
    width: 32px;
    height: 32px;
  }

  .shots :global(.zoomable) {
    border-radius: 8px;
  }

  .toc {
    padding: 28px;
    border-radius: var(--radius);
    border: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .toc-title {
    font-size: 22px;
  }

  .toc-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .toc-group-label {
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .toc-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .toc-list a {
    display: flex;
    gap: 14px;
    align-items: baseline;
    min-height: 44px;
    padding: 8px 10px;
    margin: 0 -10px;
    border-radius: 8px;
    color: var(--color-text);
    text-decoration: none;
  }

  .toc-list a:hover {
    background: var(--color-bg-soft);
  }

  .toc-text {
    display: flex;
    flex-direction: column;
  }

  .toc-step-title {
    font-weight: 700;
    font-size: 17px;
  }

  .toc-list a:hover .toc-step-title {
    color: var(--color-primary);
    text-decoration: underline;
  }

  .toc-summary {
    font-size: 15px;
    color: var(--color-muted);
  }

  .step {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .step-title {
    font-size: clamp(1.625rem, 1.3rem + 1.2vw, 2rem);
    line-height: 1.15;
    letter-spacing: -0.015em;
    margin-bottom: 6px;
  }

  .back {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 15px;
    font-weight: 700;
  }

  .cta {
    background: var(--color-bg-soft);
    border: 0;
  }

  .cta h2 {
    font-size: 26px;
  }

  .prose :global(table) {
    display: block;
    overflow-x: auto;
  }
</style>
