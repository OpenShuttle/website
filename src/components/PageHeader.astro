---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
}

const { eyebrow, title, lead } = Astro.props;
---

<header class="band-soft page-header">
  <div class="container-narrow page-header-inner">
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h1 class="h1 page-title">{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</header>

<style>
  .page-header {
    border-bottom: 1px solid var(--color-border);
  }

  .page-header-inner {
    padding-top: 64px;
    padding-bottom: 56px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .page-title {
    font-size: clamp(2.25rem, 1.6rem + 2.4vw, 3rem);
  }

  .lead {
    max-width: 720px;
  }

  @media (max-width: 640px) {
    .page-header-inner {
      padding-top: 48px;
      padding-bottom: 40px;
    }
  }
</style>
