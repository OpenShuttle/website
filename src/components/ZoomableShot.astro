---
// A screenshot that opens larger when clicked. Without JavaScript the link
// opens the full-size image; with it, the image opens in the page's lightbox
// (see Lightbox.astro).
import type { ImageMetadata } from 'astro';
import { Picture, getImage } from 'astro:assets';
import type { Locale } from '../i18n/routes';

interface Props {
  locale: Locale;
  src: ImageMetadata;
  alt: string;
  class?: string;
  widths: number[];
  sizes: string;
  /** Shown under the image in the lightbox (the alt text otherwise). */
  caption?: string;
  /** The first screenshot of the page loads at once, the others lazily. */
  eager?: boolean;
}

const { locale, src, alt, caption, class: className = 'shot', widths, sizes, eager = false } = Astro.props;
const full = await getImage({ src, format: 'webp', width: src.width, quality: 85 });
const label = locale === 'fr' ? 'Agrandir l’image' : 'Enlarge the image';
---

<a class="zoomable" href={full.src} data-zoom data-alt={alt} data-caption={caption ?? alt}>
  <Picture
    src={src}
    alt={alt}
    class={className}
    formats={['avif', 'webp']}
    widths={widths}
    sizes={sizes}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : undefined}
  />
  <span class="zoom-hint" aria-hidden="true">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="11" cy="11" r="7"></circle><path d="M20 20l-4-4M11 8v6M8 11h6"></path>
    </svg>
  </span>
  <span class="sr-only">({label})</span>
</a>

<style>
  .zoomable {
    position: relative;
    display: block;
    border-radius: var(--radius);
    cursor: zoom-in;
  }

  .zoom-hint {
    position: absolute;
    right: 12px;
    bottom: 12px;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.92);
    color: var(--color-text);
    box-shadow: 0 2px 8px rgb(22 24 29 / 0.25);
    transition: transform 0.15s;
  }

  .zoomable:hover .zoom-hint,
  .zoomable:focus-visible .zoom-hint {
    transform: scale(1.1);
  }
</style>
