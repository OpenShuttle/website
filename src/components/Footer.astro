---
import { author, contact, github, routes, type Locale } from '../i18n/routes';
import { ui } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale];
---

<footer class="site-footer on-dark">
  <div class="container footer-inner">
    <div class="footer-about">
      <span class="footer-name">OpenShuttle</span>
      <p>{t.footerTagline}</p>
      <p class="footer-credit">{t.createdBy} <a href={author.url}>{author.name}</a></p>
      <p class="footer-licence">
        {t.footerLicence} <a href={github.website}>{t.footerLicenceLink}</a>
      </p>
    </div>
    <div class="footer-columns">
      <div>
        <h2>{t.product}</h2>
        <ul>
          <li><a href={routes.download[locale]}>{t.download}</a></li>
          <li><a href={routes.guide[locale]}>{t.guide}</a></li>
          <li><a href={routes.faq[locale]}>{t.faq}</a></li>
        </ul>
      </div>
      <div>
        <h2>{t.project}</h2>
        <ul>
          <li><a href={github.repo}>{t.github}</a></li>
          <li><a href={github.contributing}>{t.contribute}</a></li>
          <li><a href={routes.signing[locale]}>{t.signing}</a></li>
        </ul>
      </div>
      <div>
        <h2>{t.legal}</h2>
        <ul>
          <li><a href={routes.privacy[locale]}>{t.privacy}</a></li>
          <li><a href={routes.legal[locale]}>{t.legalNotice}</a></li>
          <li><a href={`mailto:${contact.email}`}>{t.contact}</a></li>
        </ul>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-footer);
    color: var(--color-on-dark);
  }

  .footer-inner {
    padding-top: 48px;
    padding-bottom: 48px;
    display: flex;
    flex-wrap: wrap;
    gap: 32px 64px;
    justify-content: space-between;
  }

  .footer-about {
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-width: 360px;
    font-size: 14px;
  }

  .footer-name {
    font-size: 20px;
    font-weight: 800;
    color: #ffffff;
  }

  .footer-columns {
    display: flex;
    flex-wrap: wrap;
    gap: 32px 64px;
    font-size: 15px;
  }

  h2 {
    font-size: 15px;
    font-weight: 800;
    color: #ffffff;
    margin-bottom: 4px;
  }

  ul {
    list-style: none;
    padding: 0;
  }

  a {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    color: var(--color-on-dark);
  }

  a:hover {
    color: #ffffff;
  }

  .footer-credit a,
  .footer-licence a {
    display: inline;
  }
</style>
