---
// One dialog per page that shows a ZoomableShot's full-size image.
// Progressive enhancement: without JavaScript the links open the image itself.
import type { Locale } from '../i18n/routes';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const close = locale === 'fr' ? 'Fermer' : 'Close';
---

<dialog class="lightbox" id="lightbox" aria-label={locale === 'fr' ? 'Image agrandie' : 'Enlarged image'}>
  <button type="button" class="lightbox-close" autofocus>
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
      <path d="M6 6l12 12M18 6L6 18"></path>
    </svg>
    <span class="sr-only">{close}</span>
  </button>
  <img alt="" decoding="async" />
</dialog>

<script is:inline>
  (() => {
    const dialog = document.getElementById('lightbox');
    if (!dialog || typeof dialog.showModal !== 'function') return;
    const img = dialog.querySelector('img');
    document.addEventListener('click', (e) => {
      const link = e.target.closest('a[data-zoom]');
      if (!link || e.button !== 0 || e.ctrlKey || e.metaKey || e.shiftKey || e.altKey) return;
      e.preventDefault();
      img.src = link.href;
      img.alt = link.dataset.alt || '';
      dialog.showModal();
    });
    // A click anywhere (image, backdrop or button) closes; Escape too, natively.
    dialog.addEventListener('click', () => dialog.close());
    dialog.addEventListener('close', () => img.removeAttribute('src'));
  })();
</script>

<style>
  .lightbox {
    width: 100vw;
    height: 100vh;
    max-width: 100vw;
    max-height: 100vh;
    margin: 0;
    padding: 16px;
    border: 0;
    background: transparent;
    cursor: zoom-out;
  }

  .lightbox[open] {
    display: grid;
    place-items: center;
  }

  .lightbox::backdrop {
    background: rgb(11 13 18 / 0.88);
  }

  .lightbox img {
    max-width: min(100%, 1440px);
    max-height: calc(100vh - 32px);
    width: auto;
    height: auto;
    border-radius: 8px;
    box-shadow: 0 24px 60px rgb(0 0 0 / 0.5);
  }

  .lightbox-close {
    position: fixed;
    top: 12px;
    right: 12px;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.92);
    color: var(--color-text);
    cursor: pointer;
  }

  .lightbox-close:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: 2px;
  }
</style>
