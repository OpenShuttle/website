---
// One dialog per page that shows the ZoomableShot images full size, as a
// gallery of every screenshot of the page: previous/next buttons, arrow keys
// and swipe. Progressive enhancement: without JavaScript the links open the
// image itself.
import type { Locale } from '../i18n/routes';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t =
  locale === 'fr'
    ? { label: 'Image agrandie', close: 'Fermer', prev: 'Image précédente', next: 'Image suivante' }
    : { label: 'Enlarged image', close: 'Close', prev: 'Previous image', next: 'Next image' };
---

<dialog class="lightbox" id="lightbox" aria-label={t.label}>
  <figure class="lightbox-figure">
    <img alt="" decoding="async" />
    <figcaption>
      <span class="lightbox-count" aria-live="polite"></span>
      <span class="lightbox-caption"></span>
    </figcaption>
  </figure>
  <button type="button" class="lightbox-btn lightbox-prev" data-move="-1">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M15 5l-7 7 7 7"></path>
    </svg>
    <span class="sr-only">{t.prev}</span>
  </button>
  <button type="button" class="lightbox-btn lightbox-next" data-move="1">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M9 5l7 7-7 7"></path>
    </svg>
    <span class="sr-only">{t.next}</span>
  </button>
  <button type="button" class="lightbox-btn lightbox-close" data-close autofocus>
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
      <path d="M6 6l12 12M18 6L6 18"></path>
    </svg>
    <span class="sr-only">{t.close}</span>
  </button>
</dialog>

<script is:inline>
  (() => {
    const dialog = document.getElementById('lightbox');
    if (!dialog || typeof dialog.showModal !== 'function') return;
    const img = dialog.querySelector('img');
    const count = dialog.querySelector('.lightbox-count');
    const caption = dialog.querySelector('.lightbox-caption');
    const links = Array.from(document.querySelectorAll('a[data-zoom]'));
    dialog.classList.toggle('single', links.length < 2);
    let index = 0;

    const show = (i) => {
      index = (i + links.length) % links.length;
      const link = links[index];
      img.src = link.href;
      img.alt = link.dataset.alt || '';
      caption.textContent = link.dataset.caption || '';
      count.textContent = links.length > 1 ? `${index + 1} / ${links.length}` : '';
      // Fetch the neighbours ahead, so moving through the gallery is instant.
      [index - 1, index + 1].forEach((n) => {
        const next = links[(n + links.length) % links.length];
        if (next) new Image().src = next.href;
      });
    };

    document.addEventListener('click', (e) => {
      const link = e.target.closest('a[data-zoom]');
      if (!link || e.button !== 0 || e.ctrlKey || e.metaKey || e.shiftKey || e.altKey) return;
      e.preventDefault();
      show(links.indexOf(link));
      dialog.showModal();
    });

    dialog.addEventListener('click', (e) => {
      const move = e.target.closest('[data-move]');
      if (move) return show(index + Number(move.dataset.move));
      // The close button, or a click outside the image and its caption.
      if (e.target.closest('[data-close]') || !e.target.closest('.lightbox-figure')) dialog.close();
    });

    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') show(index + 1);
      else if (e.key === 'ArrowLeft') show(index - 1);
      else return;
      e.preventDefault();
    });

    // Swipe left or right on touch screens.
    let startX = null;
    dialog.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse') startX = e.clientX;
    });
    dialog.addEventListener('pointerup', (e) => {
      if (startX === null) return;
      const dx = e.clientX - startX;
      startX = null;
      if (Math.abs(dx) > 50 && links.length > 1) show(index + (dx < 0 ? 1 : -1));
    });

    dialog.addEventListener('close', () => {
      img.removeAttribute('src');
      links[index]?.focus();
    });
  })();
</script>

<style>
  .lightbox {
    width: 100vw;
    height: 100vh;
    max-width: 100vw;
    max-height: 100vh;
    margin: 0;
    padding: 16px 72px;
    border: 0;
    background: transparent;
  }

  .lightbox[open] {
    display: grid;
    place-items: center;
  }

  .lightbox::backdrop {
    background: rgb(11 13 18 / 0.96);
  }

  .lightbox-figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    max-width: 100%;
  }

  .lightbox img {
    max-width: min(100%, 1920px);
    max-height: calc(100vh - 96px);
    width: auto;
    height: auto;
    border-radius: 8px;
    box-shadow: 0 24px 60px rgb(0 0 0 / 0.5);
    touch-action: pan-y pinch-zoom;
  }

  .lightbox figcaption {
    display: flex;
    gap: 12px;
    align-items: baseline;
    color: #ffffff;
    font-size: 16px;
    text-align: center;
  }

  .lightbox-count {
    font: 700 14px var(--font-mono);
    color: var(--color-on-dark);
  }

  .lightbox-btn {
    position: fixed;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 0;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.92);
    color: var(--color-text);
    cursor: pointer;
  }

  .lightbox-btn:hover {
    background: #ffffff;
  }

  .lightbox-btn:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: 2px;
  }

  .lightbox-close {
    top: 12px;
    right: 12px;
  }

  .lightbox-prev,
  .lightbox-next {
    top: 50%;
    transform: translateY(-50%);
  }

  .lightbox-prev {
    left: 12px;
  }

  .lightbox-next {
    right: 12px;
  }

  .lightbox.single .lightbox-prev,
  .lightbox.single .lightbox-next {
    display: none;
  }

  /* Phones: the image takes the whole width, the arrows go below it. */
  @media (max-width: 720px) {
    .lightbox {
      padding: 72px 8px 88px;
    }

    .lightbox-prev,
    .lightbox-next {
      top: auto;
      bottom: 20px;
      transform: none;
    }

    .lightbox-prev {
      left: calc(50% - 64px);
    }

    .lightbox-next {
      right: calc(50% - 64px);
    }

    .lightbox figcaption {
      flex-direction: column;
      align-items: center;
      gap: 4px;
      font-size: 15px;
    }
  }
</style>
