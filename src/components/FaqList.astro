---
import type { FaqItem } from '../data/faq';

interface Props {
  items: FaqItem[];
}

const { items } = Astro.props;
---

<div class="faq-list">
  {
    items.map((item) => (
      <details class="faq-item">
        <summary>{item.question}</summary>
        <div class="faq-answer" set:html={item.answer} />
      </details>
    ))
  }
</div>
