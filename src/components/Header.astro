---
import logo from '../assets/logo.svg';
import { github, routes, type Locale, type RouteKey } from '../i18n/routes';
import { ui } from '../i18n/ui';

interface Props {
  locale: Locale;
  page: RouteKey | '404';
}

const { locale, page } = Astro.props;
const t = ui[locale];
const other: Locale = locale === 'fr' ? 'en' : 'fr';
const otherHref = page === '404' ? routes.home[other] : routes[page][other];
const featuresHref = `${routes.home[locale]}#${locale === 'fr' ? 'fonctionnalites' : 'features'}`;
const current = (key: RouteKey) => (page === key ? 'page' : undefined);
---

<header class="site-header">
  <nav class="container nav" aria-label={t.navLabel}>
    <a class="brand" href={routes.home[locale]} aria-label={t.homeLabel} aria-current={current('home')}>
      <img src={logo.src} alt="" width="30" height="35" />
      <span>OpenShuttle</span>
    </a>
    <div class="nav-links">
      <a href={featuresHref}>{t.features}</a>
      <a href={routes.guide[locale]} aria-current={current('guide')}>{t.guide}</a>
      <a href={routes.faq[locale]} aria-current={current('faq')}>{t.faq}</a>
      <a href={github.repo}>{t.github}</a>
    </div>
    <a class="lang" href={otherHref} hreflang={other} lang={other}>
      {t.otherLang}<span class="sr-only"> – {t.otherLangLabel}</span>
    </a>
    <a class="btn btn-primary btn-sm" href={routes.download[locale]} aria-current={current('download')}>{t.download}</a>
  </nav>
</header>

<script is:inline>
  // Phones: fold the links row while scrolling down, unfold when scrolling up.
  (() => {
    const header = document.querySelector('.site-header');
    const phone = matchMedia('(max-width: 720px)');
    let last = scrollY;
    let ticking = false;
    const update = () => {
      ticking = false;
      const y = scrollY;
      if (!phone.matches || y < 80) header.classList.remove('folded');
      else if (y > last + 4) header.classList.add('folded');
      else if (y < last - 4) header.classList.remove('folded');
      last = y;
    };
    addEventListener('scroll', () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    }, { passive: true });
  })();
</script>

<style>
  /* Sticky on every screen. On phones the links wrap to a second row, which
     folds away while scrolling down (the script below) and comes back when
     scrolling up. The header keeps its height in the layout, so nothing
     jumps: once folded, its lower part is transparent and lets clicks through. */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid var(--color-border);
    background: #ffffff;
  }

  .nav {
    padding-top: 12px;
    padding-bottom: 12px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 28px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    text-decoration: none;
    color: var(--color-text);
    font-size: 20px;
    font-weight: 800;
    letter-spacing: -0.01em;
  }

  .brand:hover {
    color: var(--color-text);
  }

  .brand img {
    width: 30px;
    height: 35px;
  }

  .nav-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 24px;
    flex: 1;
    font-size: 15px;
    font-weight: 700;
  }

  .nav-links a,
  .lang {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--color-text);
    text-decoration: none;
  }

  .nav-links a:hover {
    color: var(--color-primary);
    text-decoration: underline;
  }

  .nav-links a[aria-current='page'] {
    color: var(--color-primary);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
  }

  .lang {
    min-width: 44px;
    justify-content: center;
    font-size: 14px;
    font-weight: 700;
    color: var(--color-muted);
  }

  .lang:hover {
    color: var(--color-primary);
  }

  @media (max-width: 720px) {
    .site-header {
      transition: background-color 0.15s, border-color 0.15s;
    }

    .site-header::before {
      content: '';
      position: absolute;
      inset: 0 0 auto;
      height: 68px;
      background: #ffffff;
      border-bottom: 1px solid var(--color-border);
      opacity: 0;
      transition: opacity 0.15s;
    }

    .nav {
      position: relative;
      gap: 0 12px;
    }

    .nav-links {
      transition: opacity 0.15s, transform 0.15s, visibility 0.15s;
    }

    .site-header.folded:not(:focus-within) {
      background: transparent;
      border-bottom-color: transparent;
      pointer-events: none;
    }

    .site-header.folded:not(:focus-within)::before {
      opacity: 1;
      box-shadow: 0 2px 8px rgb(22 24 29 / 0.08);
    }

    .site-header.folded:not(:focus-within) .brand,
    .site-header.folded:not(:focus-within) .lang,
    .site-header.folded:not(:focus-within) .btn {
      pointer-events: auto;
    }

    .site-header.folded:not(:focus-within) .nav-links {
      opacity: 0;
      visibility: hidden;
      transform: translateY(-8px);
    }

    .brand {
      flex: 1;
    }

    .nav-links {
      order: 3;
      flex-basis: 100%;
      gap: 0 20px;
    }
  }
</style>
