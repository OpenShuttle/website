---
// Long-form text pages: policies and legal notice.
import Base from './Base.astro';
import PageHeader from '../components/PageHeader.astro';
import type { Locale, RouteKey } from '../i18n/routes';

interface Props {
  locale: Locale;
  page: RouteKey;
  title: string;
  description: string;
  heading: string;
  lead?: string;
  updated?: string;
}

const { locale, page, title, description, heading, lead, updated } = Astro.props;
const updatedLabel = locale === 'fr' ? 'Dernière mise à jour :' : 'Last updated:';
---

<Base locale={locale} page={page} title={title} description={description}>
  <PageHeader title={heading} lead={lead}>
    {updated && <p class="small muted">{updatedLabel} <time datetime={updated}>{new Date(updated).toLocaleDateString(locale === 'fr' ? 'fr-FR' : 'en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}</time></p>}
  </PageHeader>
  <div class="container-narrow prose-page">
    <div class="prose">
      <slot />
    </div>
  </div>
</Base>

<style>
  .prose-page {
    padding-top: 48px;
    padding-bottom: 88px;
  }

  .prose {
    max-width: 760px;
  }

  .prose :global(h2:first-child) {
    margin-top: 0;
  }
</style>
